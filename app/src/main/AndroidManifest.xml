<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Elementia"
        tools:targetApi="31">

        <!-- NEW: Splash Activity as the launcher -->
        <activity
            android:name=".activity_splash"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Welcome Activity - for first time users only -->
        <activity
            android:name=".activity_welcome"
            android:exported="false" />


        <activity
            android:name=".activity_difficulty"
            android:exported="false" />
        <activity
            android:name=".activity_quiz"
            android:exported="false" />
        <activity
            android:name=".activity_challenge"
            android:exported="false" />
        <activity
            android:name=".activity_elements"
            android:exported="false"></activity>
    </application>

</manifest>